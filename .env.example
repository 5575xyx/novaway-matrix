# NovaWay 本地/构建环境变量样例。复制为 .env.local(已被 .gitignore 忽略)后填写。
#
# 说明:内置网关的地址与密钥都通过构建期环境变量注入。script/build.ts 与
# script/build-node.ts 的 define 会把构建机上的值内联进产物;源码里绝不出现真实值。
# 两者都为空时,内置提供商不会注册——Auto 模式不可用,用户需自配 provider。

# 内置网关地址(如 http://gateway.example.com:11435/v1)
NOVAWAY_GATEWAY_EMBED_URL=

# 内置网关密钥
NOVAWAY_GATEWAY_EMBED_KEY=

# 运行时回退(用户侧可用,优先级低于构建期内联值)
NOVAWAY_GATEWAY_URL=
NOVAWAY_GATEWAY_API_KEY=
