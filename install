#!/usr/bin/env bash
set -euo pipefail

APP=novaway
# 主包名（用户 `npm i -g` 装的就是它）：平台二进制由 optionalDependencies 按 os/cpu 自动选择。
MAIN_PACKAGE="${NOVAWAY_NPM_PACKAGE:-xymt-novaway}"
INSTALL_DIR="${NOVAWAY_INSTALL_DIR:-$HOME/.$APP/bin}"

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m'

usage() {
    cat <<HELP
NovaWay Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.0.180)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL https://novaway.ai/install | bash
    curl -fsSL https://novaway.ai/install | bash -s -- --version 1.0.180
    ./install --binary /path/to/$APP
HELP
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path) no_modify_path=true; shift ;;
        *) echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2; shift ;;
    esac
done

print_message() {
    local level=$1
    local message=$2
    local color="${NC}"
    case $level in
        error) color="${RED}" ;;
    esac
    echo -e "${color}${message}${NC}"
}

fail() {
    print_message error "$1"
    exit 1
}

# ---------------------------------------------------------------------------
# 本地二进制：直接拷到安装目录，不走包管理器。
# ---------------------------------------------------------------------------
if [ -n "$binary_path" ]; then
    [ -f "$binary_path" ] || fail "Binary not found at $binary_path"
    mkdir -p "$INSTALL_DIR"
    cp "$binary_path" "$INSTALL_DIR/$APP"
    chmod 755 "$INSTALL_DIR/$APP"
    print_message info "${MUTED}Installed ${NC}$APP ${MUTED}from ${NC}$binary_path"
else
    # 已装且版本一致就跳过（显式指定版本时才比较）。
    if [ -n "$requested_version" ] && command -v "$APP" >/dev/null 2>&1; then
        installed_version=$("$APP" --version 2>/dev/null || echo "")
        if [ "$installed_version" = "${requested_version#v}" ]; then
            print_message info "${MUTED}Version ${NC}${requested_version#v}${MUTED} already installed"
            exit 0
        fi
    fi

    spec="$MAIN_PACKAGE"
    [ -n "$requested_version" ] && spec="$MAIN_PACKAGE@${requested_version#v}"

    if command -v npm >/dev/null 2>&1; then
        print_message info "${MUTED}Installing ${NC}$spec${MUTED} with npm${NC}"
        npm install -g "$spec"
    elif command -v bun >/dev/null 2>&1; then
        print_message info "${MUTED}Installing ${NC}$spec${MUTED} with bun${NC}"
        bun add -g "$spec"
    else
        fail "Neither npm nor bun found. Install Node.js (https://nodejs.org) or Bun (https://bun.sh) first."
    fi

    command -v "$APP" >/dev/null 2>&1 || fail "Installed $spec, but '$APP' is not on \$PATH."
fi

# ---------------------------------------------------------------------------
# PATH：只有本地二进制装在自定义目录时才需要改 shell 配置。
# ---------------------------------------------------------------------------
add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file" 2>/dev/null; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# $APP" >>"$config_file"
        echo "$command" >>"$config_file"
        print_message info "${MUTED}Successfully added ${NC}$APP ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

if [ -n "$binary_path" ] && [[ "$no_modify_path" != "true" ]] && [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
    current_shell=$(basename "${SHELL:-sh}")
    case $current_shell in
        fish) config_files="$XDG_CONFIG_HOME/fish/config.fish" ;;
        zsh) config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc" ;;
        *) config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile" ;;
    esac

    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ $current_shell == "fish" ]]; then
        add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
    else
        add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ] && [ -d "$INSTALL_DIR" ]; then
    echo "$INSTALL_DIR" >>"$GITHUB_PATH"
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${MUTED}NovaWay includes free models, to start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "$APP      ${MUTED}# Run command${NC}"
echo -e ""
echo -e "${MUTED}For more information visit ${NC}https://novaway.ai/docs"
echo -e ""
