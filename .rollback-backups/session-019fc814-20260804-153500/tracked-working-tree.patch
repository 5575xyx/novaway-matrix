-// SAFER_SCOPEID_USER=2, SAFER_LEVELID_CONSTRAINED=0x10000, SAFER_LEVEL_OPEN=1
-const SAFER_SCOPEID_USER = 2
-const SAFER_LEVELID_CONSTRAINED = 0x10000
-const SAFER_LEVEL_OPEN = 1
