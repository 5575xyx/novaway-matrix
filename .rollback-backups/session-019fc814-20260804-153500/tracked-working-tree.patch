-        stderr: Buffer.from(err.message),
-        timedOut,
-        restricted: false,
-      })
-    })
-    child.on("close", (code) => {
-      clearTimeout(timer)
-      resolve({
-        exitCode: code ?? (timedOut ? 1 : 0),
-        stdout: Buffer.concat(stdoutChunks),
-        stderr: Buffer.concat(stderrChunks),
-        timedOut,
-        restricted: false,
-      })
-    })
-  })
-}
