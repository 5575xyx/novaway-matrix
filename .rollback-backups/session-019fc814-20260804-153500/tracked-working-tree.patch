-  if (existing) {
-    return client.updateRelease(
-      existing.id,
-      releaseBody(input.tag, input.name, input.body, input.targetCommitish),
-    )
-  }
-  return client.createRelease(releaseBody(input.tag, input.name, input.body, input.targetCommitish))
