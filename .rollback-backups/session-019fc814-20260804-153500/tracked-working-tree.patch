-    if (eq > 0) return looksLikeFilesystemPath(arg.slice(eq + 1))
-    return false
-  }
-  if (path.isAbsolute(arg)) return true
-  if (/^[A-Za-z]:[\\/]/.test(arg)) return true
-  if (arg.startsWith("\\\\") || arg.startsWith("//")) return true
-  return false
-}
