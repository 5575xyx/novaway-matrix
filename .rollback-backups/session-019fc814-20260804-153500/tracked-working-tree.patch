+  const factKey = (item as Memory).factKey || (item as MemoryReviewCandidate).factKey
+  const parts = [`v${version}`]
+  if (factKey) parts.push(`键:${factKey}`)
+  if ((item as Memory).supersedesID) parts.push("已替代旧事实")
+  return parts.join(" · ")
