registry=https://registry.npmmirror.com
electron_mirror=https://npmmirror.com/mirrors/electron/

# ---- 同时支持 bun 与 pnpm ----
# 根 package.json 的 packageManager 写的是 bun（CI 与随包 Node 都按它取版本）。
# 不关掉这个开关，pnpm 会直接拒绝在仓库里运行："This project is configured to use bun"。
package-manager-strict=false
# 对应 bunfig.toml 的 [install] exact = true：两个包管理器都不自动加 ^。
save-exact=true
# bun 装出来是扁平 node_modules，这个仓库有大量跨包隐式依赖。先保持同样的布局，
# 免得换安装器就把构建弄坏；想验证严格模式可以临时加 --config.node-linker=isolated。
node-linker=hoisted
# bun 不校验 peer 依赖，pnpm 默认会报错。这里对齐 bun 的行为。
strict-peer-dependencies=false
